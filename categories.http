### 

@BASE_URL = http://localhost:5148

# @name debuglogin

POST {{BASE_URL}}/api/auth/debug HTTP/1.1
Content-Type: application/json

{
  "id": 1
}


### Get all categories

GET {{BASE_URL}}/api/category HTTP/1.1


### Get category

# @prompt id

GET {{BASE_URL}}/api/category/{{id}} HTTP/1.1


### Create category

POST {{BASE_URL}}/api/category HTTP/1.1
Authorization: Bearer {{debuglogin.response.body.$.token}}
Content-Type: application/json

{
  "name": {
    "Dutch": "Dingen",
    "English": "Things"
  },
  "rootCategory": "Food"
}


### Update category

# @prompt id

PUT {{BASE_URL}}/api/category/{{id}} HTTP/1.1
Authorization: Bearer {{debuglogin.response.body.$.token}}
Content-Type: application/json

{
  "name": {
    "Dutch": "Dingen",
    "English": "Things"
  },
  "rootCategory": "Food"
}


### Delete category

# @prompt destId
# @prompt id

DELETE {{BASE_URL}}/api/category/{{id}}?moveProducts={{destId}} HTTP/1.1
Authorization: Bearer {{debuglogin.response.body.$.token}}


### Get all root categories

GET {{BASE_URL}}/api/category/root HTTP/1.1
